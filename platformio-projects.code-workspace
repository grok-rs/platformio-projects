  "settings": {
    "files.associations": {
      "*.ino": "cpp"
    },
    // rust-analyzer: check the firmware with the `esp` toolchain, run the language server itself on stable.
    // No cargo.target: each Cargo workspace takes its target from its own .cargo/config.toml
    // (root: xtensa-esp32s3-none-elf for esp-hal; vent-timer/rust and debounce-idf/rust: xtensa-esp32s3-espidf).
    // LIBCLANG_PATH: esp-idf-sys generates its bindings with the clang from espup.
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.server.extraEnv": { "RUSTUP_TOOLCHAIN": "stable" },
    "rust-analyzer.cargo.extraEnv": {
      "RUSTUP_TOOLCHAIN": "esp",
