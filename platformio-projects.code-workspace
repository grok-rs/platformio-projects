{
  "folders": [
    { "path": "esp32-s3-led-blink/cpp", "name": "led-blink (C++)" },
    { "path": "esp32-s3-two-buttons/cpp", "name": "two-buttons (C++)" },
    { "path": "esp32-s3-led-button/cpp", "name": "led-button (C++)" },
    { "path": "esp32-s3-led-pwm/cpp", "name": "led-pwm (C++)" },
    { "path": "esp32-s3-bounce-test/cpp", "name": "bounce-test (C++)" },
    { "path": "esp32-s3-button-bounce/cpp", "name": "button-bounce (C++)" },
    { "path": "esp32-s3-ldr-adc/cpp", "name": "ldr-adc (C++)" },
    { "path": "esp32-s3-twilight-relay/cpp", "name": "twilight-relay (C++)" },
    { "path": "esp32-s3-embedded-cpp/cpp", "name": "embedded-cpp (C++)" },
    { "path": ".", "name": "repository (Rust workspace, docs)" }
  ],
  "settings": {
    "files.associations": {
      "*.ino": "cpp"
    },
    // rust-analyzer: check the firmware for the ESP32-S3 target with the `esp` toolchain,
    // but run the language server itself on stable.
    "rust-analyzer.cargo.target": "xtensa-esp32s3-none-elf",
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.server.extraEnv": { "RUSTUP_TOOLCHAIN": "stable" },
    "rust-analyzer.cargo.extraEnv": { "RUSTUP_TOOLCHAIN": "esp" },
    "rust-analyzer.check.extraEnv": { "RUSTUP_TOOLCHAIN": "esp" }
  },
  "extensions": {
    "recommendations": [
      "platformio.platformio-ide",
      "rust-lang.rust-analyzer",
      "wokwi.wokwi-vscode",
      "tamasfe.even-better-toml"
    ]
  }
}
